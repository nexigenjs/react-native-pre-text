{
  "name": "@nexigen/react-native-pre-text",
  "version": "0.2.0",
  "description": "Measure React Native text height, width and line count before render. Stops FlatList feeds and chats from jumping on fast scroll, makes scrollToIndex land, and enables Read more without a second render. Native TextKit and StaticLayout over Nitro Modules.",
